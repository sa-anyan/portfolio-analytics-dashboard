# Copy locally only. Keep AI_ACCESS_POLICY=disabled until hosting/auth/budget acceptance.
# Server environment controls are documented in docs/SECURITY_OPERATIONS.md.
# OPENAI_API_KEY = "replace-locally-never-commit"

# Optional OIDC configuration. Provision a provider only under operator approval.
# [auth]
# redirect_uri = "https://YOUR_HOST/oauth2callback"
# cookie_secret = "long-random-server-secret"
# client_id = "YOUR_OIDC_CLIENT"
# client_secret = "YOUR_OIDC_SECRET"
# server_metadata_url = "https://YOUR_ISSUER/.well-known/openid-configuration"
# Do not expose identity/access tokens to the browser or to Copilot.
