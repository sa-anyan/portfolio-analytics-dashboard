# TEMPLATE ONLY: replace runtime/source paths; use root-owned config mode 0600.
[Unit]
Description=Portfolio Analytics demonstration
After=network-online.target
Wants=network-online.target
[Service]
User=portfolio-demo
Group=portfolio-demo
WorkingDirectory=/opt/portfolio-demo/current
EnvironmentFile=/etc/portfolio-demo/demo.env
ExecStart=/opt/portfolio-demo/venv/bin/python -m streamlit run app.py --server.address 127.0.0.1 --server.port 8501
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/portfolio-demo
MemoryMax=3G
CPUQuota=200%
TasksMax=128
LimitNOFILE=1024
[Install]
WantedBy=multi-user.target
