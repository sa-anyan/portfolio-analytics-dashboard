# PRIVATE HOST FILE ONLY; approval required before changing disabled to public_demo.
AI_ACCESS_POLICY=disabled
AI_DEPLOYMENT_ARCHITECTURE=single_host
AI_BUDGET_DB_PATH=/var/lib/portfolio-demo/budget/requests.sqlite
AI_PROXY_VERIFIED=signed_nginx_single_host
AI_DEMO_ID=blackrock-demo
# Replace with approved end timestamp, <=30 days after offline provisioning.
AI_DEMO_END_EPOCH=REPLACE_WITH_APPROVED_TIMESTAMP
# Generate separate random 32-byte hex keys OFFLINE, never put them in GitHub.
AI_PROXY_SIGNING_KEY=REPLACE_PRIVATE_64_HEX
AI_IP_HASH_KEY=REPLACE_DIFFERENT_PRIVATE_64_HEX
OPENAI_MODEL=gpt-5.6-luna
AI_ALLOWED_MODEL=gpt-5.6-luna
AI_GLOBAL_MONTHLY_REQUESTS=20
AI_GLOBAL_MONTHLY_TOKENS=500000
AI_DEMO_TOTAL_REQUESTS=20
AI_DEMO_TOTAL_TOKENS=500000
AI_MAX_CONCURRENT_REQUESTS=1
OPENAI_LOG=error
# No provider key until separately approved. Inject dedicated project key privately.
